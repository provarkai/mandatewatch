# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API). .env.local is gitignored -- never commit real values.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used only by scripts/seed.mjs, run locally with plain Node -- never prefixed
# VITE_, so it never ships to the browser. This is the "service role" key,
# which bypasses all Row Level Security -- treat it as sensitive.
SUPABASE_SERVICE_ROLE_KEY=
